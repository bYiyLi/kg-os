{
  "name": "@kgos/web",
  "version": "0.3.12",
  "private": true,
  "description": "KG OS browser client",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "vite build && vite build --mode mcp && node ../../scripts/inline-mcp-ui.mjs",
    "check": "pnpm exec tsc -p tsconfig.json --pretty false && pnpm exec eslint src --max-warnings 0 && pnpm exec prettier --check src index.html mcp.html --ignore-unknown && pnpm exec vitest run --config ../../config/test/vitest.config.ts packages/web/src",
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort"
  },
  "dependencies": {
    "@antv/g6": "5.1.1",
    "@base-ui/react": "1.9.0",
    "@kgos/sdk": "workspace:*",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "i18next": "26.4.4",
    "lucide-react": "1.60.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.16",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  }
}
