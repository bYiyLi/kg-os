# KG OS Phase 16: one Linux amd64 kgosd process serving Web, HTTP API and MCP.
# Build stages may use Node.js to prepare browser assets and pinned native files.
# The final image contains neither Node.js nor the old TypeScript MCP service.
ARG NODE_IMAGE=node:24.15.0-bookworm-slim
ARG DEBIAN_IMAGE=debian:bookworm-slim
ARG RUST_IMAGE=rust:1.97.1-bookworm
ARG GO_BUILDER_IMAGE=golang:1.27.3-bookworm

FROM ${NODE_IMAGE} AS web-builder
WORKDIR /src
RUN npm install --global --ignore-scripts --no-audit --no-fund pnpm@10.34.5
COPY . .
RUN pnpm install --frozen-lockfile --ignore-scripts \
    && pnpm check:docs \
    && pnpm --filter @kgos/web build

# Build Jieba from its pinned Rust sources rather than downloading a retired
# six-platform npm Runtime package. Only the Linux amd64 release is delivered.
FROM ${RUST_IMAGE} AS native-builder
COPY native/jieba /src/native/jieba
RUN rustc --version | grep -q '^rustc 1.97.1 ' \
    && CARGO_TARGET_DIR=/tmp/kgos-jieba-build \
    cargo build --manifest-path /src/native/jieba/Cargo.toml --release --locked \
    && test -s /tmp/kgos-jieba-build/release/libkgos_jieba.so \
    && mkdir -p /out/runtime/extensions /out/runtime/licenses \
    && cp /tmp/kgos-jieba-build/release/libkgos_jieba.so /out/runtime/extensions/kgos-jieba.so \
    && cp /src/native/jieba/NOTICE.md /out/runtime/JIEBA-NOTICE.md \
    && cp /src/native/jieba/licenses/*.txt /out/runtime/licenses/
ARG LITHOGRAPH_VERSION=0.3.5
ARG LITHOGRAPH_LINUX_X64_SHA256=504b6dd3321007abdd4d7aff2a87ab3219518b39fec583662debea7f6fa8f7dc
RUN apt-get update \
    && apt-get install --no-install-recommends -y ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
RUN set -eu; \
    curl --fail --location --retry 5 --retry-all-errors \
      --output /tmp/lithograph.tar.gz \
      "https://github.com/bYiyLi/Lithograph/releases/download/v${LITHOGRAPH_VERSION}/lithograph-linux-x64.tar.gz"; \
    printf '%s  /tmp/lithograph.tar.gz\n' "${LITHOGRAPH_LINUX_X64_SHA256}" | sha256sum --check; \
    mkdir -p /tmp/lithograph; \
    tar -xzf /tmp/lithograph.tar.gz -C /tmp/lithograph; \
    test "$(cat /tmp/lithograph/VERSION)" = "${LITHOGRAPH_VERSION}"; \
    cp /tmp/lithograph/lithograph.so /tmp/lithograph/lithograph-openai-compatible.so /out/runtime/extensions/

FROM ${GO_BUILDER_IMAGE} AS daemon-builder
# The Go builder supplies libc/gcc and curl without a mutable apt install.
# Copy only the build-time Node executable for the immutable runtime manifest.
COPY --from=web-builder /usr/local/bin/node /usr/local/bin/node
RUN command -v gcc && command -v curl && node --version | grep -q '^v24.15.0$'
ARG GO_ARCHIVE_URL=https://go.dev/dl/go1.27.3.linux-amd64.tar.gz
RUN curl --fail --location --retry 5 --retry-all-errors --output /tmp/go.tar.gz \
      "${GO_ARCHIVE_URL}" \
    && printf '%s  /tmp/go.tar.gz\n' \
      '65efbc80fdc1fa2cd2631cad5b481777a68e8725f34e89f50fc6ac714e379b40' \
      | sha256sum --check \
    && rm -rf /usr/local/go \
    && tar -C /usr/local -xzf /tmp/go.tar.gz \
    && rm /tmp/go.tar.gz \
    && go version | grep -q 'go1.27.3 linux/amd64'
ENV PATH="/usr/local/go/bin:${PATH}"
ENV GOTOOLCHAIN=local
WORKDIR /src
COPY go.mod go.sum package.json ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
COPY --from=web-builder /src/packages/web/dist ./internal/webui/dist
RUN mkdir -p /out && CGO_ENABLED=1 GOOS=linux GOARCH=amd64 \
    go build -tags=sqlite_fts5 -trimpath -o /out/kgosd ./cmd/kgosd

COPY --from=native-builder /out/runtime/ /out/runtime/
COPY LICENSE /out/runtime/LICENSE
RUN node -e 'const fs=require("node:fs"),crypto=require("node:crypto"),path=require("node:path"); const base="/out/runtime"; fs.copyFileSync("/out/kgosd",base+"/kgosd"); fs.chmodSync(base+"/kgosd",0o755); const files=["kgosd","extensions/lithograph.so","extensions/lithograph-openai-compatible.so","extensions/kgos-jieba.so","JIEBA-NOTICE.md","licenses/sqlite-simple-tokenizer-MIT.txt","licenses/jieba-rs-MIT.txt"].map(file=>({file,sha256:crypto.createHash("sha256").update(fs.readFileSync(path.join(base,file))).digest("hex")})); const version=JSON.parse(fs.readFileSync("/src/package.json","utf8")).version; if(!/^\d+\.\d+\.\d+(-[0-9A-Za-z.-]+)?$/.test(version))throw Error("Invalid KG OS Docker version"); fs.writeFileSync(base+"/manifest.json",JSON.stringify({arch:"x64",files,platform:"linux",version},null,2)+"\n");'
RUN set -eu; \
    modules="$(go env GOPATH)/pkg/mod"; \
    mkdir -p /out/notices; \
    cp "$modules/github.com/aperturerobotics/go-quickjs-wasi-reactor@v0.15.1/LICENSE" /out/notices/QuickJS-NG-WASI-MIT.txt; \
    cp "$modules/github.com/modelcontextprotocol/go-sdk@v1.8.0/LICENSE" /out/notices/MCP-Go-SDK-Apache-MIT.txt; \
    cp "$modules/github.com/tetratelabs/wazero@v1.12.0/LICENSE" /out/notices/wazero-Apache-2.0.txt; \
    cp "$modules/github.com/tetratelabs/wazero@v1.12.0/NOTICE" /out/notices/wazero-NOTICE.txt

FROM ${DEBIAN_IMAGE}
RUN apt-get update \
    && apt-get install --no-install-recommends -y ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 kgos \
    && useradd --uid 10001 --gid 10001 --create-home kgos \
    && mkdir -p /workspace \
    && chown 10001:10001 /workspace
WORKDIR /opt/kgos
COPY --from=daemon-builder --chown=10001:10001 /out/runtime/ /opt/kgos/
COPY --from=daemon-builder /out/notices/ /opt/kgos/third-party-notices/
USER 10001:10001
ENV KGOS_ROOT=/workspace
VOLUME ["/workspace"]
EXPOSE 3777
ENTRYPOINT ["/opt/kgos/kgosd"]
CMD ["--root", "/workspace", "--host", "0.0.0.0", "--port", "3777"]
