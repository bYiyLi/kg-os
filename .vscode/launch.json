{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "KG OS development host",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/tsx",
      "runtimeArgs": ["packages/daemon/src/dev.ts"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "KG OS CLI",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/tsx",
      "runtimeArgs": ["packages/cli/src/bin.ts"],
      "args": ["--help"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "KG OS Web",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://127.0.0.1:4765",
      "webRoot": "${workspaceFolder}/packages/web",
      "sourceMaps": true
    }
  ]
}
