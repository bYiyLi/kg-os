{
  "name": "kgos",
  "version": "0.0.0",
  "private": true,
  "description": "KG OS monorepo",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "24.15.0",
    "pnpm": "10.34.5"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "pnpm validate",
    "check:dedupe": "pnpm dedupe --check",
    "check:dependencies": "node scripts/check-dependency-versions.mjs",
    "check:diff": "node scripts/check-diff.mjs",
    "check:duplicates": "jscpd packages scripts tests --format typescript,javascript,json --min-lines 8 --min-tokens 80 --threshold 0 --reporters console --ignore \"**/node_modules/**,**/dist/**,**/coverage/**,**/*.test.ts,**/*.spec.ts\" --no-tips",
    "check:exports": "node scripts/check-package-exports.mjs",
    "check:imports": "depcruise --config config/quality/dependency-cruiser.cjs --output-type err packages",
    "check:install": "pnpm install --frozen-lockfile --ignore-scripts",
    "check:licenses": "license-checker-rseidelsohn --production --excludePrivatePackages --onlyAllow \"MIT;MIT*;ISC;Apache-2.0;BSD-2-Clause;BSD-3-Clause;0BSD;MPL-2.0;Python-2.0;CC0-1.0;BlueOak-1.0.0;CC-BY-3.0;CC-BY-4.0;CC-BY-SA-4.0;(BSD-2-Clause OR MIT OR Apache-2.0);(MIT AND CC-BY-3.0);Custom: https://github.com/streetsidesoftware/cspell\" --summary",
    "check:markdown": "markdownlint-cli2 --config config/quality/markdownlint-cli2.yaml",
    "check:package": "node scripts/pack-release.mjs --temporary",
    "check:repo": "sherif --fail-on-warnings",
    "check:security": "pnpm audit --audit-level high --registry=https://registry.npmjs.org",
    "check:secrets": "secretlint --secretlintrc config/quality/secretlint.json \".npmrc\" \"README.md\" \"config/**/*.{json,yaml,yml,js,cjs,mjs,ts}\" \"docs/**/*.md\" \"packages/**/*.{ts,tsx,html,css,json}\" \"scripts/**/*.mjs\" \"tests/**/*.{ts,mjs}\" \"*.{js,cjs,mjs,ts,json,yaml,yml}\" \".github/**/*.yml\" \".vscode/**/*.json\"",
    "check:spelling": "cspell lint --config config/quality/cspell.json --no-progress --no-must-find-files \"*.{md,json,yaml,yml,js,cjs,mjs,ts}\" \"config/**/*.{json,yaml,yml,js,cjs,mjs,ts}\" \"docs/**/*.md\" \"packages/**/*.{ts,tsx,html,css,json}\" \"scripts/**/*.mjs\" \"tests/**/*.{ts,mjs}\"",
    "check:type-coverage": "type-coverage -p config/test/tsconfig.type-coverage.json --strict --show-relative-path --at-least 99",
    "check:unused": "knip --config config/quality/knip.json --no-progress",
    "check:versions": "syncpack lint",
    "clean": "node scripts/clean.mjs",
    "dev": "tsx watch --clear-screen=false packages/daemon/src/dev.ts",
    "format": "prettier --write . --ignore-unknown",
    "lint": "node scripts/tasks.mjs lint",
    "pack:release": "pnpm build && node scripts/pack-release.mjs --output artifacts/phase0",
    "setup": "node scripts/setup.mjs",
    "test": "vitest run --config config/test/vitest.config.ts",
    "test:coverage": "vitest run --config config/test/vitest.config.ts --coverage",
    "test:e2e": "pnpm build && playwright test --config config/test/playwright.config.ts",
    "test:native": "node scripts/prepare-lithograph.mjs && node scripts/native-smoke.mjs",
    "check:quick": "node scripts/tasks.mjs quick",
    "typecheck": "node scripts/tasks.mjs typecheck",
    "validate": "node scripts/tasks.mjs validate"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.5",
    "@types/node": "24.13.6",
    "@vitest/coverage-v8": "5.0.1",
    "@vitest/eslint-plugin": "1.6.27",
    "cspell": "10.3.3",
    "dependency-cruiser": "18.3.1",
    "eslint": "10.11.0",
    "eslint-plugin-sonarjs": "4.2.1",
    "globals": "17.9.0",
    "jscpd": "5.2.1",
    "knip": "6.37.0",
    "lefthook": "2.1.14",
    "license-checker-rseidelsohn": "5.0.1",
    "markdownlint-cli2": "0.23.2",
    "prettier": "3.9.8",
    "publint": "0.3.24",
    "secretlint": "13.0.5",
    "sherif": "1.13.0",
    "syncpack": "15.3.3",
    "tsx": "4.23.13",
    "type-coverage": "2.30.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook"
    ],
    "overrides": {
      "smol-toml": "1.8.0"
    }
  }
}
