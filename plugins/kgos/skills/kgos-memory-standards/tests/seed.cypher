  (old:Memory {memoryKey:'owner-a:focus-old', ownerKey:'owner-a', summary:'Use pointer hover for graph magnification', originKind:'user-report', epistemicStatus:'reported', lifecycle:'superseded', scope:'KG OS Web', validTo:datetime('2026-10-20T10:00:00+08:00')}),
  (current:Memory {memoryKey:'owner-a:focus-new', ownerKey:'owner-a', summary:'Keep the graph center magnified', originKind:'user-statement', epistemicStatus:'reported', lifecycle:'current', scope:'KG OS Web', validFrom:datetime('2026-10-20T10:00:00+08:00'), observedAt:datetime('2026-10-20T10:10:00+08:00')}),
  (procedure:Memory {memoryKey:'owner-a:library-first', ownerKey:'owner-a', summary:'Evaluate mature graph libraries before implementing custom gestures', originKind:'review-derived', epistemicStatus:'not-yet-verified', lifecycle:'current', scope:'Graph UI tasks'}),
  (episode:Memory {memoryKey:'owner-a:review', ownerKey:'owner-a', summary:'Reviewed graph interaction behavior', originKind:'actual-review', epistemicStatus:'observed', lifecycle:'current', occurredAt:datetime('2026-10-20T10:00:00+08:00'), triggerDescription:'User raised a graph interaction issue'}),
  (intent:Memory {memoryKey:'owner-a:next-review', ownerKey:'owner-a', summary:'At the next review, check center-focus behavior', originKind:'user-statement', epistemicStatus:'reported', lifecycle:'current'}),
