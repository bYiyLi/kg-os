// Synthetic isolated test data. No historical or user-instance facts are implied.
CREATE
  (environment:Entity {entityKey:'kgos-dev',name:'KG OS Dev',entityKind:'software-environment'}),
  (place:Place {placeKey:'lab-a',name:'Lab A'}),
  (window:Time {timeKey:'window-01',startAt:datetime('2026-10-20T09:00:00+08:00'),endAt:datetime('2026-10-20T12:00:00+08:00')}),
  (incidentKind:Concept {conceptKey:'incident',name:'Incident'}),
  (repairKind:Concept {conceptKey:'repair',name:'Repair attempt'}),
  (verifyKind:Concept {conceptKey:'verification',name:'Verification'}),
  (securityKind:Concept {conceptKey:'security-incident',name:'Security incident'}),
  (incident:Event {eventKey:'incident-01',summary:'Service connection lost',outcome:'observed'}),
  (run1:Event {eventKey:'run-01',summary:'First recovery attempt',outcome:'failed'}),
  (run2:Event {eventKey:'run-02',summary:'Second recovery attempt',outcome:'succeeded',occurredAt:datetime('2026-10-20T10:00:00+08:00')}),
  (verify2:Event {eventKey:'verify-02',summary:'Follow-up check failed',outcome:'failed'}),
  (security:Event {eventKey:'security-01',summary:'New type added as Knowledge',outcome:'unknown'}),
  (evidence:Source {sourceKey:'check-02',title:'Follow-up check',locator:'fixture:check-02',sourceInstance:'isolated',sourceBranch:'source'}),
  (incident)-[:HAS_TYPE]->(incidentKind),
  (run1)-[:HAS_TYPE]->(repairKind),
  (run2)-[:HAS_TYPE]->(repairKind),
  (verify2)-[:HAS_TYPE]->(verifyKind),
  (security)-[:HAS_TYPE]->(securityKind),
  (incident)-[:INVOLVES {role:'affected'}]->(environment),
  (run1)-[:INVOLVES {role:'target'}]->(environment),
  (run2)-[:INVOLVES {role:'target'}]->(environment),
  (verify2)-[:INVOLVES {role:'target'}]->(environment),
  (security)-[:INVOLVES {role:'affected'}]->(environment),
  (run1)-[:FOLLOWS]->(incident),
  (run2)-[:FOLLOWS]->(run1),
  (verify2)-[:FOLLOWS]->(run2),
  (verify2)-[:VERIFIES]->(run2),
  (verify2)-[:DOCUMENTED_BY]->(evidence),
  (run2)-[:OCCURRED_DURING]->(window),
  (run2)-[:OCCURRED_AT]->(place)
