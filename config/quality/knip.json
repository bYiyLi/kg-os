{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": [
    "@arethetypeswrong/cli",
    "@secretlint/secretlint-rule-preset-recommend",
    "license-checker-rseidelsohn",
    "secretlint",
    "publint"
  ],
  "workspaces": {
    ".": {
      "entry": ["scripts/prepare-lithograph.mjs"],
      "project": ["config/test/*.ts", "scripts/*.mjs", "tests/**/*.ts"]
    },
    "packages/sdk": {
      "project": ["src/**/*.ts"]
    },
    "packages/web": {
      "project": ["src/**/*.tsx"]
    }
  }
}
