{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": ["@secretlint/secretlint-rule-preset-recommend", "secretlint", "lefthook"],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/prepare-lithograph.mjs",
        "scripts/prepare-jieba.mjs",
        "scripts/mcp-dev-accept-unified.mjs"
      ],
      "project": ["config/test/*.ts", "scripts/*.mjs", "tests/**/*.ts"]
    },
    "packages/sdk": {
      "project": ["src/**/*.ts"]
    },
    "packages/cli": {
      "project": ["src/**/*.ts"]
    },
    "packages/web": {
      "entry": ["src/mcp-main.tsx", "src/app/styles/global.css"],
      "project": ["src/**/*.{ts,tsx,css}"]
    }
  }
}
