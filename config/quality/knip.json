{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": [
    "@arethetypeswrong/cli",
    "@secretlint/secretlint-rule-preset-recommend",
    "secretlint",
    "publint"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/prepare-lithograph.mjs",
        "scripts/prepare-jieba.mjs",
        "scripts/mcp-dev-accept.mjs"
      ],
      "project": ["config/test/*.ts", "scripts/*.mjs", "tests/**/*.ts"]
    },
    "packages/sdk": {
      "project": ["src/**/*.ts"]
    },
    "packages/cli": {
      "project": ["src/**/*.ts"]
    },
    "packages/web": {
      "project": ["src/**/*.{ts,tsx}"]
    }
  }
}
