{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "../../packages/**/*.test.ts",
    "../../packages/**/*.test.tsx",
    "../../tests/**/*.ts",
    "./playwright.config.ts",
    "./vitest.config.ts"
  ]
}
