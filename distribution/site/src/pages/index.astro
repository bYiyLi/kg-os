---
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>KG OS — Choose a language</title>
    <script is:inline define:vars={{ base }}>
      const preferred = navigator.languages?.[0] ?? navigator.language ?? "en";
      const language = preferred.toLowerCase().startsWith("zh") ? "zh" : "en";
      location.replace(`${base}${language}/`);
    </script>
  </head>
  <body>
    <p>Choose a language / 选择语言</p>
    <a href={`${base}en/`}>English</a> · <a href={`${base}zh/`}>简体中文</a>
  </body>
</html>
