---
import { copy, type Locale } from "../lib/content";

interface Props {
  locale: Locale;
  installation?: boolean;
  installationVersion?: string;
}

const { locale, installation = false, installationVersion } = Astro.props;
const t = copy[locale];
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const homeUrl = `${base}${locale}/`;
const installUrl = `${homeUrl}install/`;
const publicRepository = "https://github.com/bYiyLi/kg-releases";
const languagePath = installation ? `install/${installationVersion ? `${installationVersion}/` : ""}` : "";
---

<header class="site-header wrapper">
  <a class="logo" href={`${base}${locale}/`} aria-label="KG OS">
    <svg viewBox="0 0 48 48" fill="none" aria-hidden="true">
      <path d="M24 3.5 44.5 24 24 44.5 3.5 24 24 3.5Z" stroke="currentColor" stroke-width="4.4" stroke-linejoin="round" />
      <path d="m24 14-7 10 7 10 7-10-7-10Z" fill="currentColor" />
      <circle cx="24" cy="24" r="2.7" fill="var(--page)" />
    </svg>
    <span>KG OS</span>
  </a>
  <nav class="desktop-links" aria-label={locale === "zh" ? "网站导航" : "Site navigation"}>
    <a href={`${homeUrl}#overview`}>{t.nav[0]}</a>
    <a href={`${homeUrl}#how`}>{t.nav[1]}</a>
    <a href={`${homeUrl}#capabilities`}>{t.nav[2]}</a>
    <a href={`${homeUrl}#architecture`}>{t.nav[3]}</a>
    <a href={installUrl}>{t.nav[4]}</a>
  </nav>
  <div class="header-controls">
    <nav class="language-switch" aria-label={t.language}>
      <a href={`${base}zh/${languagePath}`} lang="zh-CN" aria-current={locale === "zh" ? "page" : undefined}>中</a>
      <span aria-hidden="true">/</span>
      <a href={`${base}en/${languagePath}`} lang="en" aria-current={locale === "en" ? "page" : undefined}>EN</a>
    </nav>
    <div class="theme-switch" role="group" aria-label={t.theme.label}>
      <button type="button" data-theme-choice="system" aria-label={t.theme.system} title={t.theme.system} aria-pressed="true">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="14" rx="2"/><path d="M8 22h8M12 18v4"/></svg>
      </button>
      <button type="button" data-theme-choice="light" aria-label={t.theme.light} title={t.theme.light} aria-pressed="false">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <button type="button" data-theme-choice="dark" aria-label={t.theme.dark} title={t.theme.dark} aria-pressed="false">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.8 15.4A9 9 0 0 1 8.6 3.2 9 9 0 1 0 20.8 15.4Z"/></svg>
      </button>
    </div>
    <a class="github-link" href={publicRepository} target="_blank" rel="noopener noreferrer">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .9a11.1 11.1 0 0 0-3.5 21.6c.56.1.76-.24.76-.54v-2.08c-3.07.67-3.71-1.3-3.71-1.3-.5-1.3-1.24-1.64-1.24-1.64-1-.69.08-.67.08-.67 1.11.08 1.69 1.14 1.69 1.14.98 1.69 2.58 1.21 3.21.92.1-.72.39-1.21.71-1.49-2.46-.27-5.05-1.23-5.05-5.49 0-1.21.44-2.2 1.14-2.99-.11-.28-.5-1.41.11-2.94 0 0 .93-.3 3.05 1.13a10.57 10.57 0 0 1 5.57 0c2.12-1.43 3.05-1.13 3.05-1.13.6 1.53.22 2.66.11 2.94.71.79 1.14 1.78 1.14 2.99 0 4.27-2.6 5.21-5.07 5.49.4.35.76 1.02.76 2.07v3.07c0 .3.2.64.77.54A11.1 11.1 0 0 0 12 .9Z"/></svg>
      <span>{t.github}</span><span aria-hidden="true">↗</span>
    </a>
  </div>
</header>
