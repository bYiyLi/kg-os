---
// cspell:words eyeline
import { copy, type Locale } from "../lib/content";

interface Props {
  locale: Locale;
}

const locale = Astro.props.locale;
const t = copy[locale].final;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<section class="agent-install-section" id="get-started" aria-labelledby="agent-install-heading">
  <div class="wrapper agent-install-content">
    <p class="eyeline">{t.label}</p>
    <h2 id="agent-install-heading">{t.heading}</h2>
    <p class="agent-install-intro">{t.description}</p>
    <ol class="manual-install-steps">
      {t.steps.map((step, index) => <li><span>{String(index + 1).padStart(2, "0")}</span>{step}</li>)}
    </ol>
    <a class="button-primary" href={`${base}${locale}/install/`}>{t.action}<span aria-hidden="true">→</span></a>
    <p class="manual-install-note">{t.note}</p>
  </div>
</section>
